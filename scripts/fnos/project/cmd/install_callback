#!/bin/bash
#
# Runs after the package files are applied.
#
# Prepares everything the service needs on first start: writable directories,
# a configuration file and the log location. Every step is idempotent because
# fnOS may re-run the install flow during recovery.

set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "${SCRIPT_DIR}/common.sh"

ensure_dirs || fail "cannot create ${TRIM_PKGVAR}"

write_default_config || fail "cannot write ${CONFIG_FILE}"

set_log_path

echo_to_logs "installed, published at ${GATEWAY_PREFIX}"

# The account is still empty at this point: the install wizard does not ask
# for it (see the manifest comment). The service starts anyway and shows an
# empty form, which is a better first run than a failed install.
exit 0
