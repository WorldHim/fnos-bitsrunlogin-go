#!/bin/bash
#
# Runs after a settings change has been applied.
#
# Restarts the service so the change takes effect.
#
# The previous process is stopped here rather than trusting config_init to
# have done it: fnOS does not promise that both halves of the pair always run
# (a settings API call may only invoke the callback), and starting while the
# old process still holds the socket would leave the new one unable to bind.

set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "${SCRIPT_DIR}/common.sh"

ensure_dirs || fail "cannot create ${TRIM_PKGVAR}"
set_log_path

stop_process || true

start_process || fail "service failed to start"

echo_to_logs "configuration applied, published at ${GATEWAY_PREFIX}"

exit 0
