#!/bin/bash
#
# Runs before a settings change is applied.
#
# There is nothing to remember: the service is published through the fnOS
# gateway at a fixed path, so a settings change cannot move it. The service is
# stopped here and started again in config_callback, which keeps the window
# where it is down as small as possible.

set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "${SCRIPT_DIR}/common.sh"

if is_running; then
	stop_process || true
fi

echo_to_logs "configuration change requested"

exit 0
